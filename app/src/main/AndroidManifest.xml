<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Only asked for when clearing data, to put the hidden drawer's numbers back into Contacts. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Swipe down on home opens the notification shade / quick settings. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Glass weather widget only: Open-Meteo over the internet, with the phone's rough location. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only when the user records their own wheel sound (asked at that moment). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Talk along: read the phone's output loudness (Visualizer on the output mix). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- A launcher must see every launchable app -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- No cloud backup: the hidden drawer must stay on this phone only. -->
    <application
        android:allowBackup="false"
        android:manageSpaceActivity=".ManageSpaceActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.OtherWorld">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification access (the user turns it on): alien glow + unread dots. -->
        <service
            android:name=".service.NotificationWatcher"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Accessibility (the user turns it on): only for double-tap to lock. -->
        <service
            android:name=".service.GestureService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/gesture_service" />
        </service>

        <!-- Shown by Android instead of "Clear data": puts the hidden drawer back on the phone first. -->
        <activity
            android:name=".ManageSpaceActivity"
            android:exported="true"
            android:excludeFromRecents="true" />

        <service
            android:name=".wallpaper.GlobeWallpaperService"
            android:exported="true"
            android:label="@string/wp_globe"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_globe" />
        </service>

        <service
            android:name=".wallpaper.AlienWallpaperService"
            android:exported="true"
            android:label="@string/wp_alien"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_alien" />
        </service>

        <service
            android:name=".wallpaper.AlienGreenWallpaperService"
            android:exported="true"
            android:label="@string/wp_alien_green"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_alien_green" />
        </service>

        <service
            android:name=".wallpaper.AlienPinkWallpaperService"
            android:exported="true"
            android:label="@string/wp_alien_pink"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_alien_pink" />
        </service>

        <service
            android:name=".wallpaper.AlienPurpleWallpaperService"
            android:exported="true"
            android:label="@string/wp_alien_purple"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_alien_purple" />
        </service>

        <service
            android:name=".wallpaper.AlienRedWallpaperService"
            android:exported="true"
            android:label="@string/wp_alien_red"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_alien_red" />
        </service>

        <service
            android:name=".wallpaper.AlienGoldWallpaperService"
            android:exported="true"
            android:label="@string/wp_alien_gold"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_alien_gold" />
        </service>

        <service
            android:name=".wallpaper.AlienIceWallpaperService"
            android:exported="true"
            android:label="@string/wp_alien_ice"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_alien_ice" />
        </service>

        <service
            android:name=".wallpaper.AlienBlueWallpaperService"
            android:exported="true"
            android:label="@string/wp_alien_blue"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_alien_blue" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.vault"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/vault_paths" />
        </provider>
    </application>

</manifest>
