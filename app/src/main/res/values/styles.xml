    <string name="wp_globe">Spinning globe</string>
    <string name="wp_alien">Alien (cyan)</string>
    <string name="wp_alien_green">Alien (neon green)</string>
    <string name="wp_alien_pink">Alien (neon pink)</string>
    <string name="wp_alien_purple">Alien (neon purple)</string>
