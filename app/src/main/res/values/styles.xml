    <style name="Theme.OtherWorld" parent="android:Theme.Material.NoActionBar">
        <!-- The phone's own wallpaper shows behind home -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
    <string name="gesture_desc">Lets Other World lock your screen when you double-tap empty space on the home screen. Other World does not read or collect anything on your screen.</string>
</resources>
